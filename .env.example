# Environment Configuration for MedTex
# Python 3.12 + PostgreSQL 16 recommended

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/medtex
USE_DATABASE=true

# JWT Secret Key (required, >=32 chars)
SECRET_KEY=change-this-to-a-long-random-secret-min-32-chars

# PubMedBERT Configuration
ENABLE_PUBMEDBERT=true

# HIPAA PHI Detection
ENABLE_PHI_DETECTION=true
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=logs/audit.log

# Redis Configuration
ENABLE_CACHE=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate Limiting
DEFAULT_RATE_LIMIT=60
AUTHENTICATED_RATE_LIMIT=120

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Prometheus Monitoring
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090

# Heavy Models (set to false for faster startup)
ENABLE_HEAVY_MODELS=false

# Active Learning
ENABLE_ACTIVE_LEARNING=true
UNCERTAINTY_THRESHOLD=0.7
ACTIVE_LEARNING_SAMPLE_SIZE=10

# Model Versioning
ENABLE_MODEL_VERSIONING=true
DEFAULT_MODEL_VERSION=pubmedbert
ENABLE_AB_TESTING=false

# GLM-OCR Configuration
ENABLE_GLM_OCR=false
OLLAMA_BASE_URL=http://localhost:11434
GLM_OCR_MODEL=glm-ocr

# VLM OCR APIs (optional)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_google_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
